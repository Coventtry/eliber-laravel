APP_NAME="E-liber"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eliber
DB_USERNAME=eliber_user
DB_PASSWORD=
# Solo requerido para Docker (docker-compose.prod.yml)
DB_ROOT_PASSWORD=

DEFAULT_INSTITUCION_NOMBRE="Institución Principal"
DEFAULT_INSTITUCION_SLUG=principal
DEFAULT_INSTITUCION_ESTADO=activa
DEFAULT_ADMIN_NOMBRE="Administrador"
DEFAULT_ADMIN_USUARIO=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=CambiarEsto#2024
SEED_SAMPLE_DATA=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Producción (descomentar y configurar) ────────────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://eliber.tuinstitucion.edu.ar
# LOG_LEVEL=error
# DB_HOST=db
# QUEUE_CONNECTION=database
# SESSION_DRIVER=database
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=eliber.tuinstitucion.edu.ar
# CORS_ALLOWED_ORIGINS=https://eliber.tuinstitucion.edu.ar
