APP_NAME="E-liber"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://eliber.ragnar-industria.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=eliber
DB_USERNAME=eliber
DB_PASSWORD=CAMBIAR_PASSWORD
DB_ROOT_PASSWORD=CAMBIAR_ROOT_PASSWORD

DEFAULT_INSTITUCION_NOMBRE="Mi Institución"
DEFAULT_INSTITUCION_SLUG=principal
DEFAULT_INSTITUCION_ESTADO=activa
DEFAULT_ADMIN_NOMBRE="Administrador"
DEFAULT_ADMIN_USUARIO=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN
SEED_SAMPLE_DATA=false

L5_SWAGGER_GENERATE_ALWAYS=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
